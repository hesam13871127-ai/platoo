# Copy to .env (repo root) or export these values before running the API.
# Anything marked PROD blocks production boot when left insecure.

NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed to call the API and open sockets.
# Native mobile apps send no Origin header and are unaffected.
# PROD: must be non-empty or the API refuses to boot.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Database (MySQL 8) ---
# Either set the parts below or a single DATABASE_URL; explicit parts win.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vibetable
DB_PASSWORD=vibetable
DB_NAME=vibetable
DB_CONNECTION_LIMIT=10
# DATABASE_URL=mysql://vibetable:vibetable@127.0.0.1:3306/vibetable

# --- Auth ---
# PROD: each secret must be unique and >= 32 chars (generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=replace-with-a-64-character-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- One-time passcodes ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Local dev needs no SMS provider: when OTP_WEBHOOK_URL is empty and NODE_ENV
# is not production, the API logs the code and returns it as `devCode`.
# DEV_OTP_ENABLED=true forces that behavior (e.g. staging WITH a webhook).
# PROD: must be false or unset (the API refuses to boot otherwise) and
# OTP_WEBHOOK_URL must point at the approved SMS provider.
DEV_OTP_ENABLED=true
OTP_WEBHOOK_URL=

# --- Social login ---
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.vibetable.app

# --- Voice (LiveKit) ---
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Misc ---
# Reserved for future Redis-backed features (queues, shared rate limits).
REDIS_URL=redis://127.0.0.1:6379
# Kill switch for HTTP/socket rate limiting (tests, emergencies).
RATE_LIMIT_ENABLED=true

# --- In-app purchases (real-money coin top-ups) ---
# DEV ONLY: accepts JSON test receipts so the full buy -> verify -> credit loop works
# with no store configuration. PROD: must be false (the API refuses to boot otherwise).
DEV_IAP_ENABLED=true
# Apple App Store Server API (from App Store Connect > Users and Access > Integrations).
IAP_APPLE_ISSUER_ID=
IAP_APPLE_KEY_ID=
# Contents of the .p8 key file. Use literal \n for line breaks in single-line env files.
IAP_APPLE_PRIVATE_KEY=
# Keep true until real production purchases exist; production receipts are rejected while set.
IAP_APPLE_SANDBOX=true
# Google Play Developer API (service account with "View financial data" + reply-to-review
# roles not required; monetization read + acknowledge needs the release-manager-ish grant).
IAP_GOOGLE_SERVICE_ACCOUNT_EMAIL=
IAP_GOOGLE_PRIVATE_KEY=
IAP_GOOGLE_PACKAGE_NAME=com.vibetable.app
