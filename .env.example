NODE_ENV=development
PORT=3000
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
DATABASE_URL=mysql://vibetable:vibetable@127.0.0.1:3306/vibetable
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vibetable
DB_PASSWORD=vibetable
DB_NAME=vibetable
DB_CONNECTION_LIMIT=10
JWT_ACCESS_SECRET=replace-with-a-64-character-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
DEV_OTP_ENABLED=true
OTP_WEBHOOK_URL=
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.vibetable.app
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
REDIS_URL=redis://127.0.0.1:6379
