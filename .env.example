# Copy to .env (repo root) or export these values before running the API.
# Anything marked PROD blocks production boot when left insecure.

NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed to call the API and open sockets.
# Native mobile apps send no Origin header and are unaffected.
# PROD: must be non-empty or the API refuses to boot.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Database (MySQL 8) ---
# Either set the parts below or a single DATABASE_URL; explicit parts win.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vibetable
DB_PASSWORD=vibetable
DB_NAME=vibetable
DB_CONNECTION_LIMIT=10
# DATABASE_URL=mysql://vibetable:vibetable@127.0.0.1:3306/vibetable

# --- Auth ---
# PROD: each secret must be unique and >= 32 chars (generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=replace-with-a-64-character-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- One-time passcodes ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# PROD: must be false; devCode is only returned when true.
DEV_OTP_ENABLED=true
OTP_WEBHOOK_URL=

# --- Social login ---
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.vibetable.app

# --- Voice (LiveKit) ---
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Misc ---
# Reserved for future Redis-backed features (queues, shared rate limits).
REDIS_URL=redis://127.0.0.1:6379
# Kill switch for HTTP/socket rate limiting (tests, emergencies).
RATE_LIMIT_ENABLED=true
